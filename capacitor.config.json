{
  "appId": "com.ducatapp.ducat",
  "appName": "Ducat",
  "webDir": "dist",
  "ios": {
    "scheme": "App",
    "contentInset": "never",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native"
    }
  }
}
