{
  "appId": "app.ducat",
  "appName": "Ducat",
  "webDir": "dist",
  "ios": {
    "scheme": "Ducat",
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "backgroundColor": "#f5f6f8"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#f5f6f8",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native"
    }
  }
}
