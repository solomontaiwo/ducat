{
  "name": "soldi-sotto",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "homepage": "https://solomontaiwo.github.io/soldi-sotto",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "analyze": "ANALYZE=true vite build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "postbuild": "cp dist/index.html dist/404.html",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-soldi-sotto \"vitest run --config vitest.rules.config.js\"",
    "test:e2e": "playwright test",
    "test:functions": "node --check functions/index.js && node --check functions/lib/deleteAccount.js && node --check functions/scripts/migrate-transactions-v2.mjs && node --test \"functions/test/*.test.js\"",
    "test:all": "npm run lint && npm run test:coverage && npm run test:rules && npm run test:functions && npm audit --omit=dev --audit-level=high && npm run build && npm run check:bundle && npm run test:e2e",
    "preview": "vite preview",
    "test:coverage": "vitest run --config vitest.config.js --coverage"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@use-gesture/react": "^10.3.1",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.18.0",
    "framer-motion": "^13.2.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^1.28.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-icons": "^5.3.0",
    "react-loading-skeleton": "^3.5.0",
    "react-responsive": "^10.0.0",
    "recharts": "^3.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.12.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.32.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "volta": {
    "node": "24.0.0"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.4"
    }
  }
}
