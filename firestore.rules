rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return hasVerifiedEmail() && request.auth.uid == userId;
    }

    function isValidV2Transaction(data) {
      return data.keys().hasOnly([
          'userId', 'amount', 'amountMinor', 'currency', 'description', 'date',
          'dateKey', 'category', 'type', 'createdAt', 'updatedAt', 'schemaVersion'
        ]) &&
        data.keys().hasAll([
          'userId', 'amount', 'amountMinor', 'currency', 'description', 'date',
          'dateKey', 'category', 'type', 'createdAt', 'updatedAt', 'schemaVersion'
        ]) &&
        data.userId is string &&
        data.amount is number && data.amount > 0 && data.amount <= 1000000 &&
        data.amountMinor is int && data.amountMinor > 0 && data.amountMinor <= 100000000 &&
        data.currency == 'EUR' &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 200 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.type in ['income', 'expense'] &&
        data.date is timestamp &&
        data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.createdAt is timestamp && data.updatedAt is timestamp &&
        data.schemaVersion == 2;
    }

    function isValidRecurring(data) {
      return data.keys().hasOnly([
          'userId', 'type', 'amountMinor', 'currency', 'description', 'category', 'frequency',
          'anchorDateKey', 'nextIndex', 'mode', 'paused', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasAll([
          'userId', 'type', 'amountMinor', 'currency', 'description', 'category', 'frequency',
          'anchorDateKey', 'nextIndex', 'mode', 'paused', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string &&
        data.type in ['income', 'expense'] &&
        data.amountMinor is int && data.amountMinor > 0 && data.amountMinor <= 100000000 &&
        data.currency == 'EUR' &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 200 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.frequency in ['weekly', 'monthly', 'yearly'] &&
        data.anchorDateKey is string && data.anchorDateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.nextIndex is int && data.nextIndex >= 0 && data.nextIndex <= 10000 &&
        data.mode in ['auto', 'confirm'] &&
        data.paused is bool &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidBudgets(data) {
      return data.keys().hasOnly(['userId', 'limits', 'updatedAt']) &&
        data.keys().hasAll(['userId', 'limits', 'updatedAt']) &&
        data.userId is string &&
        data.limits is map && data.limits.size() <= 40 &&
        data.updatedAt == request.time;
    }

    function isValidPreferences(data) {
      return data.keys().hasOnly([
          'userId', 'monthStartDay', 'defaultType', 'defaultCategory', 'quickAmounts',
          'hiddenCategories', 'categoryOrder', 'lastBackupAt', 'updatedAt'
        ]) &&
        data.userId is string &&
        data.monthStartDay is int && data.monthStartDay >= 1 && data.monthStartDay <= 31 &&
        data.defaultType in ['last', 'expense', 'income'] &&
        (data.defaultCategory == null || (data.defaultCategory is string && data.defaultCategory.size() <= 60)) &&
        data.quickAmounts is list && data.quickAmounts.size() >= 1 && data.quickAmounts.size() <= 6 &&
        data.hiddenCategories is list && data.hiddenCategories.size() <= 40 &&
        data.categoryOrder is map && data.categoryOrder.keys().hasOnly(['expense', 'income']) &&
        (data.lastBackupAt == null || data.lastBackupAt is int) &&
        data.updatedAt == request.time;
    }

    function isValidProfileName(value) {
      return value is string && value.size() >= 3 && value.size() <= 50;
    }

    match /transactions/{transactionId} {
      allow get, list: if isOwner(resource.data.userId);
      // Every document must use the v2 schema (migration completed 2026-10-09).
      allow create: if isOwner(request.resource.data.userId) &&
        isValidV2Transaction(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time);
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isValidV2Transaction(request.resource.data) &&
        (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time);
      allow delete: if isOwner(resource.data.userId);
    }

    match /recurring/{ruleId} {
      allow get, list: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) &&
        isValidRecurring(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      // nextIndex only moves forward, so a stale device cannot re-register
      // occurrences that were already turned into movements.
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.nextIndex >= resource.data.nextIndex &&
        isValidRecurring(request.resource.data) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(resource.data.userId);
    }

    // One document per user, keyed by uid: category -> monthly limit in cents.
    match /budgets/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) &&
        request.resource.data.userId == userId &&
        isValidBudgets(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // One document per user: synced app preferences.
    match /preferences/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) &&
        request.resource.data.userId == userId &&
        isValidPreferences(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['username', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.email is string &&
        isValidProfileName(request.resource.data.username) &&
        isValidProfileName(request.resource.data.displayName) &&
        request.resource.data.username == request.resource.data.displayName &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'displayName', 'email', 'updatedAt']) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.email is string &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isValidProfileName(request.resource.data.username) &&
        isValidProfileName(request.resource.data.displayName) &&
        request.resource.data.username == request.resource.data.displayName &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Legacy username lookups are intentionally inaccessible: email-based login
    // prevents public username and email enumeration.
    match /usernames/{username} {
      allow read, write: if false;
    }
  }
}
