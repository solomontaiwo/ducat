# Packages the executable compiled on Arch Linux.
pkgname=ducat-bin
pkgver=${DUCAT_VERSION:?Set DUCAT_VERSION}
pkgrel=1
pkgdesc='Personal finance application'
arch=('x86_64')
url='https://github.com/solomontaiwo/ducat'
depends=('webkit2gtk-4.1' 'gtk3' 'libappindicator' 'xdotool' 'hicolor-icon-theme')
source=('root.tar')
sha256sums=('SKIP')
options=('!strip')

package() {
  cp -a "$srcdir/usr" "$pkgdir/"
}
