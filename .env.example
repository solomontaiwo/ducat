# Supabase → Project Settings → API (URL e chiave "publishable", o la vecchia "anon").
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Opzionale: endpoint che riceve i report di errore (JSON via sendBeacon). Aggiungerne l'origine a connect-src nella CSP.
VITE_ERROR_REPORT_URL=
VITE_APP_VERSION=
# Mostra "Elimina account" nel profilo (usa la funzione SQL delete_my_account)
VITE_ENABLE_ACCOUNT_DELETION=false
