# Supabase → Project Settings → API (URL e chiave "publishable", o la vecchia "anon").
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Opzionale: endpoint che riceve i report di errore (JSON via sendBeacon). Aggiungerne l'origine a connect-src nella CSP.
VITE_ERROR_REPORT_URL=
VITE_APP_VERSION=
# URL pubblico dell'app web: è la destinazione dei link di conferma e reset
# password quando l'app gira in desktop o su iOS (deve essere HTTPS e finire
# con "/"). Se vuoto usa il deploy GitHub Pages ufficiale.
VITE_DESKTOP_WEB_URL=
# Solo per la build Mac App Store: nasconde aggiornamenti e self-update.
# VITE_APP_STORE=1
# "Elimina account" nel profilo (usa la funzione SQL delete_my_account).
# Attivo salvo impostarlo esplicitamente a "false": la App Store richiede
# l'eliminazione in-app per ogni app che permette di creare un account.
VITE_ENABLE_ACCOUNT_DELETION=true

# Solo per gli script di migrazione (scripts/firebase-to-supabase): NON usare il
# prefisso VITE_, altrimenti Vite includerebbe la chiave nel bundle del client.
SUPABASE_SECRET_KEY=
