{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ducat-dev",
  "compatibility_date": "2026-11-01",
  // Attach dev.ducatapp.com in the Cloudflare dashboard.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
